# Copy this file to .env and change the values. Never commit .env.

ENVIRONMENT=local
LOG_LEVEL=INFO

# The API connects as a restricted role so Postgres row-level security applies to it.
DATABASE_URL=postgresql+asyncpg://rka_app:rka_app@localhost:5432/rka
# Migrations run as the schema owner.
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://rka:rka@localhost:5432/rka

# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-string-of-48-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

CORS_ORIGINS=["http://localhost:5173"]

# Background jobs.
REDIS_URL=redis://localhost:6379/0

# Uploaded files.
STORAGE_DIR=data/uploads
MAX_UPLOAD_MB=20

# "fake" works offline with no key (keyword-like matching only).
# "openai" gives real semantic search and needs OPENAI_API_KEY.
EMBEDDING_PROVIDER=fake
# OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small

# Starting values; tune them with the evaluation set.
CHUNK_TARGET_TOKENS=600
CHUNK_OVERLAP_TOKENS=100
